@charset "utf-8";

* { box-sizing: border-box; margin: 0px; padding: 0px; }

body { background: rgb(255, 255, 255); font-family: -apple-system, BlinkMac=
SystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; color: rgb(31=
, 41, 51); height: 100vh; display: flex; overflow: hidden; }

.sidebar { width: 250px; flex: 0 0 auto; height: 100vh; overflow-y: auto; b=
ackground: rgb(246, 248, 250); border-right: 1px solid rgb(225, 229, 234); =
padding: 20px 16px; display: flex; flex-direction: column; gap: 22px; }

.sidebar h1 { font-size: 16px; font-weight: 700; }

.group-title { font-size: 11px; font-weight: 700; letter-spacing: 0.08em; t=
ext-transform: uppercase; color: rgb(107, 119, 133); margin-bottom: 8px; }

.btn-col { display: flex; flex-direction: column; gap: 6px; }

.btn-row { display: flex; gap: 6px; }

.btn-row .btn { flex: 1 1 0%; }

.btn { background: rgb(255, 255, 255); border: 1px solid rgb(207, 214, 222)=
; color: rgb(31, 41, 51); padding: 9px 12px; font-size: 13px; border-radius=
: 8px; cursor: pointer; text-align: left; transition: background 0.15s, bor=
der-color 0.15s; }

.btn:hover { background: rgb(238, 242, 246); }

.btn.active { background: rgb(0, 194, 203); border-color: rgb(0, 169, 177);=
 color: rgb(0, 38, 42); font-weight: 700; }

.btn.center { text-align: center; }

.btn.primary { background: rgb(0, 194, 203); border-color: rgb(0, 169, 177)=
; color: rgb(0, 38, 42); font-weight: 700; text-align: center; }

.btn.primary:hover { background: rgb(0, 170, 178); }

.url-input { width: 100%; padding: 9px 10px; font-size: 13px; border: 1px s=
olid rgb(207, 214, 222); border-radius: 8px; margin-bottom: 6px; }

.check { display: flex; align-items: center; gap: 8px; font-size: 13px; cur=
sor: pointer; }

.info { font-size: 12px; color: rgb(107, 119, 133); line-height: 1.6; }

.info b { color: rgb(31, 41, 51); }

.stage { flex: 1 1 0%; min-width: 0px; height: 100vh; overflow: auto; displ=
ay: flex; justify-content: center; align-items: center; padding: 24px; back=
ground: rgb(255, 255, 255); }

.scale-wrap { flex: 0 0 auto; position: relative; }

.scale-inner { transform-origin: left top; position: absolute; top: 0px; le=
ft: 0px; }

.device { background: rgb(0, 0, 0); display: flex; flex-direction: column; =
position: relative; box-shadow: rgb(51, 51, 51) 0px 0px 0px 4px, rgba(0, 0,=
 0, 0.45) 0px 25px 50px -12px; }

.screen { display: flex; flex-direction: column; overflow: hidden; backgrou=
nd: rgb(0, 0, 0); position: relative; }

.bar-top, .bar-bottom { flex: 0 0 auto; background: rgb(0, 0, 0); color: rg=
b(255, 255, 255); user-select: none; }

.app-area { flex: 1 1 0%; min-height: 0px; background: rgb(17, 20, 26); pos=
ition: relative; }

.app-area iframe { width: 100%; height: 100%; border-width: medium; border-=
style: none; border-color: currentcolor; border-image: none; background: rg=
b(255, 255, 255); display: block; }

.bar-top { display: flex; justify-content: space-between; align-items: cent=
er; font-size: 12px; font-weight: 500; padding: 0px 16px; }

.bar-top .l, .bar-top .r { display: flex; align-items: center; gap: 7px; }

.bar-top.tablet { font-size: 13px; }

.volte { font-size: 9px; border: 1px solid rgb(255, 255, 255); padding: 1px=
 3px; border-radius: 3px; font-weight: 700; letter-spacing: 0.5px; }

.ico { width: 14px; height: 14px; fill: rgb(255, 255, 255); }

.bar-top.ios { font-size: 15px; font-weight: 600; padding: 0px 34px 8px; al=
ign-items: flex-end; }

.bar-top.ipad { font-size: 12px; font-weight: 600; padding: 0px 22px; }

.dyn-island { position: absolute; background: rgb(0, 0, 0); z-index: 5; bor=
der-radius: 20px; box-shadow: rgb(26, 26, 26) 0px 0px 0px 1px inset; }

.nav-android { display: flex; align-items: center; justify-content: space-a=
round; padding: 0px 30px; }

.nav-android.tablet { justify-content: center; gap: 45px; }

.nav-btn { background: none; border-width: medium; border-style: none; bord=
er-color: currentcolor; border-image: none; width: 40px; height: 40px; disp=
lay: flex; align-items: center; justify-content: center; opacity: 0.85; cur=
sor: pointer; }

.nav-btn:hover { opacity: 1; }

.nav-ico { fill: none; stroke: rgb(255, 255, 255); stroke-width: 2; stroke-=
linecap: round; stroke-linejoin: round; }

.nav-ios { display: flex; align-items: center; justify-content: center; }

.home-pill { background: rgb(255, 255, 255); border-radius: 3px; opacity: 0=
.9; }
