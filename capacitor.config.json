{
  "appId": "com.trevor.dugoutpulse",
  "appName": "Dugout Pulse",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "cleartext": true
  },
  "android": {
    "buildOptions": {
      "releaseType": "APK"
    }
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "backgroundColor": "#121923",
      "showSpinner": false
    }
  }
}
